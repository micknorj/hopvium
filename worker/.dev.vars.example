# npm run dev creates .private/.dev.vars with a random local secret automatically.
# For an independent Wrangler setup, use a .dev.vars file beside its config.
# Generate your own secret. Never reuse a public example as a production secret.
ROOM_HMAC_KEY=replace-with-at-least-32-random-secret-characters
ALLOWED_ORIGINS=http://127.0.0.1:8788,http://localhost:8788
